. = 0x70400;
of_2_unicast_4_buff_0 = .;
. += 0x1000;
. = 0x74000;
of_2_unicast_4_buff_1 = .;
. += 0x1000;
. = 0x78000;
of_1_unicast_4_0_cons_buff_0 = .;
. += 0x1000;
. = 0x7C000;
of_1_unicast_4_0_cons_buff_1 = .;
. += 0x1000;
  .bss : { *(.bss*) } > data
}
